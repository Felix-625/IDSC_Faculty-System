# IDSC Faculty System - Server Environment Variables

PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details:
# Example: mongodb+srv://admin:mySecretPassword@cluster0.abcde.mongodb.net/idsc_faculty_system?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret for Authentication Token Generation
JWT_SECRET=idsc_super_secret_jwt_key_2026_change_in_production

# Default Password for Initial Accounts
DEMO_PASSWORD=Password123!

# External Systems Integration (Registrar & Finance Group APIs)
# When the other groups publish their endpoints, enter them here:
REGISTRAR_API_URL=http://localhost:5001/api/registrar
REGISTRAR_API_KEY=your_registrar_secret_key
FINANCE_API_URL=http://localhost:5002/api/finance
FINANCE_API_KEY=your_finance_secret_key
